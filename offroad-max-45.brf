# ============================================================
#  offroad-max-45.brf  -  "Massimizza sterrato"  -  Moto 200 kg
#  Tracciatori Carbonari - profilo BRouter (v0.5)
#
#  v0.3: NIENTE divieti assoluti (tranne scale/marciapiedi).
#  Le vie dubbie (grade5, access=private) costano molto ma restano
#  percorribili: cosi' il motore trova alternative in montagna.
#  La legalita' la segnala il colore nero sulla mappa, non il blocco.
#
#  v0.4 introduceva "multiply" e variabili d'appoggio: BRouter rispondeva
#  HTTP 500. v0.5 rifa' le stesse due correzioni usando SOLO i costrutti
#  gia' presenti e funzionanti nella v0.3 (switch + or, numeri scritti).
#
#  (1) BUCO DELLE "unclassified". In v0.3 costavano 1.3, quasi quanto una
#      carrareccia (1.0). Ma la pagina le classifica ASFALTO (in Monferrato
#      le comunali minori sono quasi sempre asfaltate). Il motore le
#      sceglieva credendole gratis e la mappa le dipingeva di rosso: da qui
#      "troppo asfalto" e le deviazioni lunghissime. Ora costano come
#      l'asfalto. residential e living_street c'erano gia'; mancava solo
#      unclassified: era un buco, non una scelta.
#
#  (2) PROVA DI STERRATO PRIMA DELL'ASFALTO. Una via con surface o tracktype
#      che dicono "non pavimentato" resta economica QUALUNQUE sia la sua
#      classe. Senza questa riga si punirebbero anche le comunali davvero
#      bianche: l'errore opposto.
#
#  (3) ASFALTO GRADUATO. Quando l'asfalto e' inevitabile il motore prende la
#      strada MINORE invece della provinciale: per 200 kg e' anche piu'
#      sicura. I valori sono scritti (niente moltiplicazioni): 45 per le
#      comunali asfaltate, 67.5 tertiary, 90 secondary, 135 statali.
#
#  Il costo e' sempre AL METRO e initialcost resta 0: cosi' il motore
#  minimizza i METRI di asfalto. Con una penalita' fissa all'ingresso
#  preferirebbe una sola deviazione lunga a tre attraversamenti brevi.
# ============================================================
---context:global
# Quanto "costa" 1 m di asfalto rispetto a 1 m di sterrato.
assign avoid_asphalt = 45
assign validForBikes = true
assign validForFoot  = false
assign validForCars  = false
# la pendenza ora conta: le salite hanno un costo
# NOTA: 250 e' alto. In Langa/Monferrato lo sterrato e' spesso piu' ripido
# dell'asfalto di fondovalle, quindi spinge verso il piano = verso l'asfalto.
# Se dopo la v0.5 resta troppo asfalto in zone mosse, prova 120-150.
assign uphillcost     = 250
assign uphillcutoff   = 12
assign downhillcost   = 200
assign downhillcutoff = 14
assign turnInstructionMode = 0
---context:way
assign turncost = 0
assign costfactor
  switch or ford=yes ford=unknown                                                    10000
  switch highway=footway|pedestrian|steps                                            10000
  switch or surface=gravel|fine_gravel|compacted|unpaved|ground|dirt|earth|grass|sand|mud|pebblestone|rock tracktype=grade2|grade3|grade4|grade5   1
  switch highway=motorway|trunk|primary                                              135
  switch highway=secondary                                                           90
  switch highway=tertiary                                                            67.5
  switch or surface=asphalt|concrete|paved|paving_stones|sett|cobblestone or tracktype=grade1 highway=unclassified|residential|living_street   avoid_asphalt
  switch access=private|no                                                           8
  switch tracktype=grade5                                                            2
  switch highway=track|bridleway                                                     1
  switch highway=service                                                             1.3
  switch highway=path                                                                3
  switch highway=cycleway                                                            6
  1.3
---context:node
assign initialcost = 0
